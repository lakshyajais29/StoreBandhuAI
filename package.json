{
  "name": "bandhu-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Bandhu AI agent service (Node/Express) for storebandhu.com",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "mock:laravel": "node mock-laravel/server.js",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "evals": "node evals/run.js",
    "lint": "eslint .",
    "token:dev": "node scripts/dev-token.js",
    "wallet:grant": "node scripts/grant-tokens.js",
    "plan:set": "node scripts/set-plan.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "axios": "^1.20.0",
    "bullmq": "^6.3.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mongoose": "^9.10.1",
    "openai": "^7.15.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "nock": "^14.0.17",
    "supertest": "^7.2.2"
  }
}
