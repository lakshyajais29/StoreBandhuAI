# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
TRUST_PROXY=1

# ---------- Merchant session JWT (minted by Laravel, ADR-005 ⛔ confirm with Laravel dev) ----------
SESSION_JWT_ISSUER=storebandhu-laravel
SESSION_JWT_AUDIENCE=bandhu-agent
# HS256 shared secret (>= 32 chars) OR RS256 public key (preferred in production)
SESSION_JWT_SECRET=dev-session-secret-please-change-0123456789
# SESSION_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ADMIN_SERVICE_SECRET=change-me-admin-secret-32chars-min

# ---------- Laravel ----------
LARAVEL_API_BASE_URL=http://localhost:8000
LARAVEL_AGENT_SERVICE_TOKEN=dev-service-token
LARAVEL_TIMEOUT_MS=8000

# ---------- LLM (ADR-002) ----------
# fake = offline keyword router for demos; glm = real model
LLM_PROVIDER=fake
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.7-flash
LLM_TIMEOUT_MS=20000
AGENT_MAX_ITERATIONS=4
AGENT_REQUEST_BUDGET_MS=45000

# ---------- Data ----------
# Transactions REQUIRE a replica set (docker-compose provides rs0)
MONGO_URI=mongodb://localhost:27017/bandhuai?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# ---------- Storage (ADR-010) ----------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/files
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=bandhu-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_BASE_URL=https://media.storebandhu.com

# ---------- Media generation ----------
MEDIA_GATEWAY=mock
FAL_KEY=
# ⚠️ verify model IDs on fal.ai before going live
IMAGE_MODEL_ID=fal-ai/flux-kontext/dev
VIDEO_MODEL_DEFAULT_ID=fal-ai/seedance-2.0-fast/image-to-video
VIDEO_MODEL_PERSON_ID=fal-ai/kling-video/v3/image-to-video
VIDEO_UNKNOWN_PERSON_ROUTE=person
MOCK_MEDIA_FAIL_RATE=0

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Policy / business (ADR-006, ADR-009 ⛔ owner decisions) ----------
PII_HMAC_SECRET=dev-only-pii-secret-change-me
TRIAL_TOKENS=50
PLAN_TOKENS_EXPIRE=true
CHAT_TURN_COST=1

# ---------- Kill switches ----------
FEATURE_WRITES=true
FEATURE_MEDIA=true
FEATURE_VIDEO=true
FEATURE_ORDERS=true
